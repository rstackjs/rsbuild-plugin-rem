    "@types/node": "^24.13.3",
    "@types/postcss-pxtorem": "^6.1.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-pxtorem": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
